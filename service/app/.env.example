# Local development (CP-09): key-pair auth with the settings of connection <connection>. Copy to .env (git-ignored).
SNOWFLAKE_ACCOUNT=<ORG>-<ACCOUNT>
SNOWFLAKE_USER=<YOUR_USER>
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/<your_key>.p8
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=WH_ACOCO_APP
PORT=3001
